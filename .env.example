# werust local development environment overrides.
# Copy to `.env` (git-ignored) and fill in, then run via `source .env && cargo run`
# (or a direnv-style loader — werust deliberately bundles NO runtime `.env`
# loader; the binary simply reads its process env).

# Overrides the default public Ethereum RPC endpoint (`https://mainnet.infura.io/v3/9aa3d95b3bc440fa88ea12eaa4456161`)
# used for ENS resolution. Read ONCE at session construction, so a change
# needs a relaunch. Leave empty (or unset) to use the public default.
# A private endpoint (your own node, e.g. the `https://your-private-rpc.example.com/`
# shape) keeps your ENS lookups off a shared public RPC.
# NEVER commit a real RPC URL — not here, not in any tracked file. `.env`,
# `.env.local`, and `.env.*.local` are git-ignored; this `.env.example` is the
# only env file that belongs in the repo.
WERUST_RPC_URL=
